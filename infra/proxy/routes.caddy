# Host routing shared by every environment (ADR-002, ADR-012).
# Imported by Caddyfile (deployed, HTTPS) and Caddyfile.local (http://{sub}.localhost).
#
#   api.<root>         -> api, global context (no tenant)
#   admin.<root>       -> backoffice web
#   <root>, www.<root> -> root site [POR DEFINIR: root site upstream]; 404 until it exists
#   {sub}.<root>/api   -> api, tenant context (the api resolves the tenant from Host)
#   {sub}.<root>/*     -> app web
#   anything else      -> 404 (malformed subdomain, nested labels)
#
# reverse_proxy keeps the original Host and sets X-Forwarded-For, X-Forwarded-Proto and
# X-Forwarded-Host, replacing the client's values unless the request comes from trusted_proxies.
# Whether a well-formed subdomain belongs to a tenant is decided by the api (404 TENANT_NOT_FOUND).

(platodo_routes) {
	@platform_api host api.{$PLATODO_ROOT_DOMAIN}
	handle @platform_api {
		reverse_proxy {$PLATODO_API_UPSTREAM}
	}

	@backoffice host admin.{$PLATODO_ROOT_DOMAIN}
	handle @backoffice {
		reverse_proxy {$PLATODO_BACKOFFICE_UPSTREAM}
	}

	@root_site host {$PLATODO_ROOT_DOMAIN} www.{$PLATODO_ROOT_DOMAIN}
	handle @root_site {
		respond 404
	}

	# ADR-012 subdomain format: at least 3 chars of a-z, 0-9 and single inner hyphens (this also rejects
	# the "xn--" prefix). The 63-char maximum is exact only without hyphens (RE2 has no lookahead);
	# DNS caps labels at 63 and the api validates the exact rule again before any lookup.
	# The "*.<root>" site address already limits the host to a single label under the root domain.
	@tenant expression `{host}.matches("^[a-z0-9](?:[a-z0-9]|-[a-z0-9]){2,62}\\.")`
	handle @tenant {
		@tenant_api path /api /api/*
		handle @tenant_api {
			reverse_proxy {$PLATODO_API_UPSTREAM}
		}
		handle {
			reverse_proxy {$PLATODO_APP_UPSTREAM}
		}
	}

	handle {
		respond 404
	}
}
